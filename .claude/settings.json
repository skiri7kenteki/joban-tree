{
  "model": "opusplan",
  "permissions": {
    "allow": [
      "Bash(npm test *)",
      "Bash(npm run test *)",
      "Bash(npm run build *)",
      "Bash(npm run lint *)",
      "Bash(npx vitest *)",
      "Bash(npx playwright test *)",
      "Bash(npx tsc *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git fetch *)",
      "Bash(git pull --rebase *)",
      "Bash(rg *)",
      "Bash(ls *)"
    ],
    "deny": [
      "Read(./dist/**)",
      "Read(./node_modules/**)",
      "Read(./package-lock.json)",
      "Read(./public/eval/**)",
      "Read(./public/trees/**)",
      "Read(./src/assets/fonts/**)",
      "Read(./playwright-report/**)",
      "Read(./test-results/**)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [{ "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/check-push.mjs\"" }]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "node \"$CLAUDE_PROJECT_DIR/.claude/statusline.mjs\""
  }
}
