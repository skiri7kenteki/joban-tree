{
  "name": "joban-tree",
  "private": true,
  "version": "0.21.0",
  "description": "将棋の序盤対策ツリーをスマホ・iPad で作る PWA",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "vite build",
    "preview": "vite preview --host",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.sw.json",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "bake": "vite build --config pc/bake/vite.config.ts --logLevel warn && node pc/bake/dist/bake.mjs"
  },
  "dependencies": {
    "@preact/signals": "^2.11.4",
    "preact": "^11.2.0",
    "tsshogi": "^2.3.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@preact/preset-vite": "^2.10.6",
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.1.0"
  }
}
